# Copy to .env.local and fill in. Never commit the filled version.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Database (app state: users, saved views, watchlists) ---
DATABASE_URL=postgresql://user:pass@localhost:5432/tradecenter

# --- Cache ---
REDIS_URL=redis://localhost:6379

# --- Analytics warehouse ---
DUCKDB_PATH=./data/processed/trade.duckdb
PARQUET_ROOT=./data/processed

# --- Object storage (Cloudflare R2, S3-compatible) ---
R2_ACCOUNT_ID= not known
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tradecenter-data
R2_PUBLIC_URL=

# --- Upstream data sources ---
# UN Comtrade: https://comtradeplus.un.org/  (subscription key, rate-limited)
COMTRADE_API_KEY=
# World Bank WITS / WDI: no key required
# WTO Tariff Download Facility: https://tariffdata.wto.org/
WTO_API_KEY=

# --- Auth ---
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Observability ---
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
