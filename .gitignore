# claude
.claude/settings.local.json

# Natural Earth source shapefiles — refetched by data:geo:prepare
data/geo/ne_pov/*.shp
data/geo/ne_pov/*.dbf
data/geo/ne_pov/*.shx
data/geo/ne_pov/*.prj
